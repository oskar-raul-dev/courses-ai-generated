-- Fase 15 · la lectura no repetible: a lee el saldo dos veces y b lo cambia en el medio.
-- uv run lab race -f 15-aislamiento-comparado/nonrepeatable_read_mysql.race --isolation read-committed
-- @engine mysql
-- @isolation read committed
-- @setup UPDATE staging.debtor SET balance = 28.00 WHERE debtor_id = 1
-- @check SELECT balance FROM staging.debtor WHERE debtor_id = 1
a1: SET SESSION TRANSACTION ISOLATION LEVEL {isolation};
a2: START TRANSACTION;
a3: SELECT balance FROM staging.debtor WHERE debtor_id = 1;
b1: SET SESSION TRANSACTION ISOLATION LEVEL {isolation};
b2: START TRANSACTION;
b3: UPDATE staging.debtor SET balance = balance - 10 WHERE debtor_id = 1;
b4: COMMIT;
a4: SELECT balance FROM staging.debtor WHERE debtor_id = 1;
a5: COMMIT;
-- @permutation a1 a2 a3 b1 b2 b3 b4 a4 a5
