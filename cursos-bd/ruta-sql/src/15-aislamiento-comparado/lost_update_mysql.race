-- Fase 15 · la actualización perdida: dos cajas cobran al mismo deudor (28,00) y cada una escribe el saldo que
-- calculó la aplicación: 18,00 (pagó 10) y 23,00 (pagó 5). El saldo correcto es 13,00.
-- uv run lab race -f 15-aislamiento-comparado/lost_update_mysql.race --isolation read-committed
-- @engine mysql
-- @isolation read committed
-- @setup UPDATE staging.debtor SET balance = 28.00 WHERE debtor_id = 1
-- @check SELECT balance FROM staging.debtor WHERE debtor_id = 1
a1: SET SESSION TRANSACTION ISOLATION LEVEL {isolation};
a2: START TRANSACTION;
a3: SELECT balance FROM staging.debtor WHERE debtor_id = 1;
b1: SET SESSION TRANSACTION ISOLATION LEVEL {isolation};
b2: START TRANSACTION;
b3: SELECT balance FROM staging.debtor WHERE debtor_id = 1;
a4: UPDATE staging.debtor SET balance = 18.00 WHERE debtor_id = 1;
b4: UPDATE staging.debtor SET balance = 23.00 WHERE debtor_id = 1;
a5: COMMIT;
b5: COMMIT;
-- @permutation a1 a2 a3 b1 b2 b3 a4 b4 a5 b5
