-- ss02 · la lectura sucia (Fase 15), en SQL Server: b lee el pago que a todavía no confirmó, y a se arrepiente.
--   uv run --extra sqlserver lab race -f ss02-pesimista-contra-rcsi/dirty_read.race --isolation read-uncommitted
-- Es lo mismo que pide la pista WITH (NOLOCK) en una consulta.
-- @engine sqlserver
-- @database ss02
-- @setup ALTER DATABASE ss02 SET READ_COMMITTED_SNAPSHOT OFF WITH ROLLBACK IMMEDIATE
-- @isolation read uncommitted
-- @setup UPDATE dbo.debtor SET balance = 28.00 WHERE debtor_id = 1
-- @check SELECT balance FROM dbo.debtor WHERE debtor_id = 1
a1: BEGIN TRAN;
a2: UPDATE dbo.debtor SET balance = balance - 10 WHERE debtor_id = 1;
b1: SET TRANSACTION ISOLATION LEVEL {isolation}; BEGIN TRAN;
b2: SELECT balance FROM dbo.debtor WHERE debtor_id = 1;
a3: ROLLBACK;
b3: COMMIT;
-- @permutation a1 a2 b1 b2 a3 b3
