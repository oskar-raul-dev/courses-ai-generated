-- Fase 18 · el formulario de hemograma abierto a la hora del almuerzo (Postgres).
-- a abre el hemograma para editarlo y lo bloquea; b quiere corregir el mismo; c mira quién espera a quién.
-- uv run lab race -f 18-bloqueos-deadlocks-y-ddl/lunch_form.race
-- @engine postgres
-- @setup UPDATE staging.hemogram SET hematocrit = '41', version = 1 WHERE hemogram_id = 1
-- @check SELECT hematocrit, version FROM staging.hemogram WHERE hemogram_id = 1
a1: BEGIN;
a2: SELECT hematocrit FROM staging.hemogram WHERE hemogram_id = 1 FOR UPDATE;
b1: UPDATE staging.hemogram SET hematocrit = '42' WHERE hemogram_id = 1;
c1: SELECT pid, pg_blocking_pids(pid) AS blocked_by, wait_event_type, state, left(query, 45) FROM pg_stat_activity WHERE datname = current_database() AND pid <> pg_backend_pid() AND backend_type = 'client backend' AND state <> 'idle' ORDER BY backend_start;
a3: UPDATE staging.hemogram SET hematocrit = '40' WHERE hemogram_id = 1;
a4: COMMIT;
