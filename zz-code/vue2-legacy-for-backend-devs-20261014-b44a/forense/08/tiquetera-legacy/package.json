{
  "name": "tiquetera-legacy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "mock": "json-server --watch db.json --port 3000",
    "sockets": "node server/socket-server.js",
    "dev": "concurrently \"npm run mock\" \"npm run sockets\" \"npm run serve\""
  },
  "dependencies": {
    "axios": "^0.21.1",
    "bootstrap": "^4.6.2",
    "chart.js": "^2.9.4",
    "core-js": "^2.6.5",
    "jquery": "^3.6.0",
    "lodash": "^4.17.21",
    "popper.js": "^1.16.1",
    "socket.io-client": "^2.4.0",
    "vue": "2.6.14",
    "vue-router": "^3.6.5",
    "vuelidate": "^0.7.7",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "^3.12.0",
    "@vue/cli-plugin-eslint": "^3.12.0",
    "@vue/cli-service": "^3.12.0",
    "babel-eslint": "^10.0.1",
    "concurrently": "^5.3.0",
    "eslint": "^5.16.0",
    "eslint-plugin-vue": "^5.0.0",
    "json-server": "^0.16.3",
    "socket.io": "^2.4.1",
    "stubby": "^5.1.1",
    "vue-template-compiler": "2.6.14"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "rules": {},
    "parserOptions": {
      "parser": "babel-eslint"
    }
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ]
}
