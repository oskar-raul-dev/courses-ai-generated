{
  "name": "certcore/api",
  "description": "API de inspecciones y certificaciones",
  "type": "project",
  "require": {
    "php": "^7.1.3",
    "laravel/lumen-framework": "5.8.*",
    "firebase/php-jwt": "^5.0",
    "vlucas/phpdotenv": "^3.3"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "classmap": [
      "database/seeds"
    ]
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require-dev": {
    "mockery/mockery": "^1.0",
    "phpunit/phpunit": "^8.5"
  }
}
