-- Ejercicio 11 · lo mismo en MySQL, REPEATABLE READ.
-- @engine mysql
-- @isolation repeatable read
-- @setup UPDATE staging.debtor SET balance = 28.00 WHERE debtor_id = 1
-- @check SELECT balance FROM staging.debtor WHERE debtor_id = 1
a1: SET SESSION TRANSACTION ISOLATION LEVEL {isolation};
b1: SET SESSION TRANSACTION ISOLATION LEVEL {isolation};
a2: START TRANSACTION;
b2: START TRANSACTION;
a3: SELECT balance FROM staging.debtor WHERE debtor_id = 1 FOR UPDATE;
b3: SELECT balance FROM staging.debtor WHERE debtor_id = 1 FOR UPDATE;
a4: UPDATE staging.debtor SET balance = 18.00 WHERE debtor_id = 1;
a5: COMMIT;
b4: UPDATE staging.debtor SET balance = 13.00 WHERE debtor_id = 1;
b5: COMMIT;
-- @permutation a1 b1 a2 b2 a3 b3 a4 a5 b4 b5
